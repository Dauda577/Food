{
  "expo": {
    "name": "Food",
    "slug": "Food",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image1.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/image1.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow ShopApp to use Face ID for secure login.",
        "NSPhotoLibraryUsageDescription": "Allow ShopApp to access your photos to add product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/image1.jpg",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "food",
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ShopApp to use Face ID for secure login."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ShopApp to access your photos to add product images."
        }
      ]
    ]
  }
}